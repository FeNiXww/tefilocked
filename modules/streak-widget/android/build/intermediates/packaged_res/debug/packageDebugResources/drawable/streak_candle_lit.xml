<?xml version="1.0" encoding="utf-8"?>
<!-- One completed day in the large widget's weekly row. Plain shape drawable
     (not a bitmap) so it stays crisp at any dp size the layout gives it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
  <gradient
    android:type="linear"
    android:angle="270"
    android:startColor="#D4A94A"
    android:endColor="#8C6A24" />
</shape>
