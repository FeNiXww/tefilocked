<?xml version="1.0" encoding="utf-8"?>
<!--
  SMALL: the glanceable minimum — star + streak count, nothing else. Answers
  "where am I right now" in under a second; no status copy competing for
  attention. Not a cropped Medium/Large — its own composition.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layoutDirection="rtl"
  android:background="@drawable/streak_widget_background">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <FrameLayout
      android:layout_width="60dp"
      android:layout_height="60dp">

      <ImageView
        android:id="@+id/widget_star_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/streak_star_dormant" />

      <ImageView
        android:id="@+id/widget_celebrate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/streak_celebrate_overlay"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/widget_streak_number"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:fontFamily="sans-serif-black"
      android:textSize="28sp"
      android:textColor="@color/widget_text_primary"
      android:text="0" />

    <TextView
      android:id="@+id/widget_streak_caption"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:textSize="11sp"
      android:textColor="@color/widget_text_secondary"
      android:text="@string/streak_widget_caption" />

  </LinearLayout>
</FrameLayout>
