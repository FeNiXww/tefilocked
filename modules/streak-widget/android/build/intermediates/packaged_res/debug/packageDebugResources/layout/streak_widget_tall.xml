<?xml version="1.0" encoding="utf-8"?>
<!--
  TALL: a narrow but generously-high placement (Android's own default drag
  size is 2x3 — narrow width, a lot of height) is not just "Small stretched."
  A fixed-size Small composition centered in that much extra height reads as
  awkward dead space above/below the content, so Tall keeps Small's narrow
  width but spends the height on a bigger star and adds the status line
  Medium/Large earn from their own extra room.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layoutDirection="rtl"
  android:background="@drawable/streak_widget_background">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <FrameLayout
      android:layout_width="76dp"
      android:layout_height="76dp">

      <ImageView
        android:id="@+id/widget_star_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/streak_star_dormant" />

      <ImageView
        android:id="@+id/widget_celebrate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/streak_celebrate_overlay"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/widget_streak_number"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:fontFamily="sans-serif-black"
      android:textSize="32sp"
      android:textColor="#16202E"
      android:text="0" />

    <TextView
      android:id="@+id/widget_streak_caption"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:textSize="11sp"
      android:textColor="#57616F"
      android:text="@string/streak_widget_caption" />

    <TextView
      android:id="@+id/widget_status_line"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:fontFamily="sans-serif-medium"
      android:textSize="13sp"
      android:textColor="#3E6E99"
      android:gravity="center"
      android:maxLines="2"
      android:text="" />

  </LinearLayout>
</FrameLayout>
